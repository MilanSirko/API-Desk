# Supabase project URL
url=https://your-project.supabase.co

# Supabase service role key. Keep this secret and only set it on Render/local backend.
service=your-supabase-service-role-key

# Public service URLs used by the backend for OAuth and redirects
BACKEND_URL=https://your-service.onrender.com
FRONTEND_URL=https://your-site.vercel.app
